{
    "name": "pr3set-llc/silverstripe-elemental-blog",
    "description": "Show recent posts from a featured blog.",
    "license": "BSD-3-Clause",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "blog",
        "element",
        "block"
    ],
    "authors": [
        {
            "name": "Dynamic",
            "email": "dev@dynamicagency.com",
            "homepage": "https://www.dynamicagency.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "dnadesign/silverstripe-elemental": "^5.0",
        "sheadawson/silverstripe-dependentdropdownfield": "^3.0",
        "silverstripe/framework": "^5",
        "silverstripe/blog": "^4"
    },
    "conflict": {
        "silverstripe/framework": "<5 || >=6"
    },
    "replace": {
        "dynamic/silverstripe-collection": "*"
    },
    "require-dev": {
        "silverstripe/recipe-testing": "^3",
        "silverstripe/widgets": "^3",
        "squizlabs/php_codesniffer": "^3.0",
        "silverstripe/standards": "^1"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Dynamic\\Elements\\Blog\\": "src/",
            "Dynamic\\Elements\\Blog\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true,
            "silverstripe/recipe-plugin": true
        },
        "process-timeout": 600
    },
    "scripts": {
        "lint": "vendor/bin/phpcs src/ tests/",
        "lint-clean": "vendor/bin/phpcbf src/ tests/"
    },
    "extra": {
        "branch-alias": {
            "dev-5.x": "5.x-dev"
        }
    }
}